    "db:studio": "drizzle-kit studio",
    "vercel-build": "npm run db:migrate && next build"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "bcryptjs": "3.0.3",
    "drizzle-orm": "0.45.4",
    "exceljs": "^4.4.0",
    "next": "16.4.3",
    "next-auth": "4.24.15",
    "nodemailer": "10.3.1",
    "pg": "8.16.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.15.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "^8.18.1",
    "autoprefixer": "10.4.20",
    "drizzle-kit": "0.31.11",
    "postcss": "8.5.32",
    "tailwindcss": "3.4.19",
    "tsx": "4.23.15",
