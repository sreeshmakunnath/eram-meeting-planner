# PostgreSQL (Neon in production: use the pooled connection string).
DATABASE_URL=

# next-auth. Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Public URL used in email links
APP_URL=http://localhost:3000

# Email (SMTP). Leave SMTP_HOST empty in development: emails are printed to the server console instead.
# Microsoft 365: smtp.office365.com, port 587. Resend: smtp.resend.com, port 465, user "resend", password = API key.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# The two Super Admins created by `npm run db:seed` (only needed when you run the seed).
# USERNAME defaults to the part of the email before "@". Leave PASSWORD empty to get a random one printed.
# Passwords need 8+ characters, an upper-case letter, a number and a symbol.
SUPER_ADMIN_1_NAME=
SUPER_ADMIN_1_EMAIL=
SUPER_ADMIN_1_USERNAME=
SUPER_ADMIN_1_PASSWORD=
SUPER_ADMIN_2_NAME=
SUPER_ADMIN_2_EMAIL=
SUPER_ADMIN_2_USERNAME=
SUPER_ADMIN_2_PASSWORD=

# Encrypts vendor portal passwords (AES-256-GCM). 32 random bytes in base64; keep it the same everywhere that
# shares a database, or saved passwords become unreadable. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIALS_KEY=
